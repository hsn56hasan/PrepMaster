[Unit]
# PrepMaster için AYRI Cloudflare tüneli (harita servisinin tünelinden bağımsız).
# Tünel token'ı /etc/cloudflared/prepmaster.env dosyasında: TUNNEL_TOKEN=...
# (dosya: sahibi root, izin 600 — token'ı sohbete, e-postaya yazmayın)
Description=Cloudflare Tunnel - PrepMaster
After=network-online.target prepmaster.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/cloudflared/prepmaster.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
