# ==============================================================================
# PrepMaster Production Environment Configuration
# ==============================================================================

PORT=8050
HOST=0.0.0.0
ENVIRONMENT=production
PREPMASTER_DB_PATH=/app/data/prepmaster.db
# ZORUNLU: en az 32 karakter, rastgele. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Boş bırakılırsa veya örnek değer kullanılırsa üretimde uygulama BAŞLAMAZ.
SECRET_KEY=
SESSION_EXPIRY_HOURS=24
ALLOWED_ORIGINS=https://prepmaster.edu.tr,https://www.prepmaster.edu.tr,https://prepmaster.local,http://localhost:8050,http://127.0.0.1:8050

# Geliştirme kolaylığı: 1 yapılırsa doğrulama/SMS kodları yanıtta döner, simüle ödeme ve
# simüle Google girişi açılır. ÜRETİMDE KULLANILAMAZ (ENVIRONMENT=production ile açılmaz).
DEMO_MODE=0

# E-posta (şifre sıfırlama, .edu.tr doğrulama, hoş geldin ve destek bildirimleri).
# Gönderen ve destek bildirim alıcısı:
EMAIL_FROM="PrepMaster <prepmasteryonetici@gmail.com>"
SUPPORT_NOTIFY_EMAIL=prepmasteryonetici@gmail.com
# a) Brevo HTTPS API (brevo.com — günde 300 e-posta ücretsiz; özel domain gerekmeden Gmail gönderen adresi doğrulanabilir, Railway Free/Hobby ile tam uyumlu)
BREVO_API_KEY=
# b) ya da Resend HTTPS API (resend.com — ayda 3.000 e-posta ücretsiz; alan adı doğrulaması gerekir, Railway Free/Hobby ile uyumlu)
RESEND_API_KEY=
# c) ya da SMTP (Not: Railway yalnızca Pro plan ve üzerinde giden SMTP portlarına izin verir)
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Google ile giriş: Google Cloud Console > OAuth istemci kimliği (Web). Boşsa Google girişi kapalıdır.
GOOGLE_CLIENT_ID=

# Edge Security & Nginx Configuration
DOMAIN_NAME=prepmaster.edu.tr
TZ=Europe/Istanbul

# Cloudflare Integration (Optional for automated WAF API calls)
# CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# PayTR Sanal POS Integration (Ücretsiz başvuru sonrası PayTR Mağaza Panelinden alınır)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = PayTR test modu (mağaza panelinde test modu açıkken test kartlarıyla dener). Canlıda 0.
PAYTR_TEST_MODE=1
# Boş bırakılırsa sitenin kendi /odeme-sonuc sayfası kullanılır (önerilen).
PAYTR_OK_URL=
PAYTR_FAIL_URL=
# 1 yapılırsa PayTR hata ayrıntılarını müşteriye gösterir; yalnızca kurulum sırasında aç.
PAYTR_DEBUG=0
# PayTR mağaza panelinde "Bildirim URL" olarak şu adres girilmeli:
#   https://<alan-adınız>/api/payment/paytr/callback
